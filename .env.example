# Docker Composeはこのfileの複製である`.env`を読む。値はローカル開発専用とし、
# 他環境や実運用の認証情報を書かない。`.env`はGit管理外。
#
#   cp .env.example .env
#   # 3つのpasswordを生成して貼る。URLへ埋めるのでhex等のURL安全な文字列にする。
#   openssl rand -hex 32

# DB superuser。migrationと管理作業で使う。
CARD_PULSE_POSTGRES_PASSWORD=

# runtime roleのpassword。API containerとWorker containerがそれぞれ使う。
CARD_PULSE_API_DB_PASSWORD=
CARD_PULSE_WORKER_DB_PASSWORD=

# host側へ公開するport。bind先は常に127.0.0.1で、compose.yamlが固定する。
CARD_PULSE_DB_PORT=5432
CARD_PULSE_API_PORT=8000
